# Pydantic Settings가 읽는 CLOVA Studio 인증·연결 정보. 실제 키는 커밋하지 않는다.
CLOVASTUDIO_API_KEY=
CLOVASTUDIO_API_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai

# 모델명과 생성 파라미터는 pension_agent/config/hcx.py에서 버전 관리한다.

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# FastAPI 서버 포트
PORT=8000

# Docling 오프라인 파서는 tools/docling_parser/.env.example을 별도로 사용한다.
