# CLOVA Studio(HyperCLOVA X) API 인증 키. 실제 값은 절대 커밋하지 않는다.
CLOVA_STUDIO_API_KEY=

# CLOVA Studio API 호스트
CLOVA_STUDIO_HOST=https://clovastudio.stream.ntruss.com

# Function calling에 사용하는 HCX 모델명 (예: HCX-005)
HCX_MODEL_FUNCTION_CALLING=HCX-005

# 답변 생성에 사용하는 HCX 모델명 (예: HCX-DASH-002)
HCX_MODEL_GENERATION=HCX-DASH-002

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# FastAPI 서버 포트
PORT=8000

# CLOVA Studio 인증 정보 (NCP 콘솔 > CLOVA Studio > API Key 발급 후 채워넣기)
CLOVA_STUDIO_API_KEY=
# CLOVA Studio API 엔드포인트 (예: clovastudio.stream.ntruss.com)
CLOVA_STUDIO_HOST=