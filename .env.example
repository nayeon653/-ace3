# Pydantic Settings가 읽는 CLOVA Studio 인증·연결 정보. 실제 키는 커밋하지 않는다.
CLOVASTUDIO_API_KEY=
CLOVASTUDIO_API_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai

# 모델명과 생성 파라미터는 pension_agent/config/hcx.py에서 버전 관리한다.

# Qdrant Cloud 또는 로컬 Qdrant 연결. API key는 Cloud에서만 필요하다.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pension_documents_v1
QDRANT_TIMEOUT_SECONDS=30
QDRANT_PREFETCH_LIMIT=30
# 비우면 *.cloud.qdrant.io hostname에서 자동 판정한다.
QDRANT_CLOUD_INFERENCE=

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# FastAPI 서버 포트
PORT=8000

# 배포 이미지나 릴리스를 만든 Git 커밋 SHA. 로컬에서는 비워둘 수 있다.
DEPLOY_COMMIT_SHA=

# Qdrant Cloud 또는 로컬 Qdrant 연결. API key는 Cloud에서만 필요하다.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pension_documents_v1
# 비우면 *.cloud.qdrant.io hostname에서 자동 판정한다.
QDRANT_CLOUD_INFERENCE=

# LangSmith는 개발자별 개인 무료 계정과 개인 project를 로컬 .env에 설정한다.
# 팀 공용 key/workspace/project나 배포 환경 설정으로 관리하지 않는다.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 하나의 workspace에만 연결된 개인 key라면 비워둘 수 있다.
LANGSMITH_WORKSPACE_ID=
# 개발자별로 구분되는 개인 project 이름을 입력한다.
LANGSMITH_PROJECT=
LANGSMITH_TRACING_SAMPLING_RATE=1.0

# Docling 오프라인 파서는 tools/docling_parser/.env.example을 별도로 사용한다.
