#!/usr/bin/env bash
# 커밋 전 시크릿/대용량 산출물 스테이징을 차단한다.
set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

blocked=0

fail() {
  echo "[pre-commit] $1"
  blocked=1
}

# .env 파일 차단 (.env.example은 허용)
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    .env|.env.*)
      if [ "$f" != ".env.example" ]; then
        fail "환경변수 파일이 스테이징되어 있습니다: $f (커밋 금지)"
      fi
      ;;
  esac
done <<< "$staged_files"

# 대용량/재생성 가능 산출물 차단
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    data/raw/*|*.zip|*.faiss|*.db|*.sqlite3)
      fail "원본/산출물 파일이 스테이징되어 있습니다: $f (.gitignore 대상)"
      ;;
  esac
done <<< "$staged_files"

# API 키로 보이는 패턴 감지 (nv-로 시작하는 20자 이상 토큰, X-NCP-* 헤더 값)
while IFS= read -r f; do
  [ -z "$f" ] && continue
  [ -f "$f" ] || continue
  if git diff --cached -- "$f" | grep -Eq '^\+.*\bnv-[A-Za-z0-9]{20,}\b'; then
    fail "API 키로 보이는 패턴(nv-...)이 포함되어 있습니다: $f"
  fi
  if git diff --cached -- "$f" | grep -Eiq '^\+.*X-NCP-[A-Za-z0-9-]+\s*[:=]\s*[A-Za-z0-9._-]{16,}'; then
    fail "NCP 인증 헤더 값으로 보이는 패턴이 포함되어 있습니다: $f"
  fi
done <<< "$staged_files"

if [ "$blocked" -eq 1 ]; then
  echo ""
  echo "커밋이 차단되었습니다. 위 항목을 git reset HEAD <file> 로 스테이징 해제한 뒤 다시 커밋하세요."
  exit 1
fi

exit 0
